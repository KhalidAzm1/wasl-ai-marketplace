# Copy to .env.local for local development. Never commit a real .env.local.

# Used only by the server-side API routes (/api/request-access, /api/suggest-tool)
# to file GitHub Issues on the employee's behalf. Requires a fine-grained PAT or
# GitHub App installation token scoped ONLY to the wasl-ai-marketplace repository,
# with "Issues: write" permission and nothing else.
GITHUB_TOKEN=
GITHUB_OWNER=KhalidAzm1
GITHUB_REPO=wasl-ai-marketplace

# Reserved for future Microsoft Entra ID (Azure AD) SSO integration.
# See /web/docs/architecture.md for the planned auth flow — not implemented yet.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=
